# Local development: copy to server/.env
# Docker Compose:    copy to .env (next to docker-compose.yml)

NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://quiz:quiz@localhost:5432/quiz_competition
# Password for the bundled PostgreSQL container (Docker Compose only).
POSTGRES_PASSWORD=change-me

# REQUIRED in production: a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me
JWT_EXPIRES_IN=12h

# Admin account created on startup / `npm run migrate` if it doesn't exist yet.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@quiz.local
ADMIN_PASSWORD=Admin@123

# Server processes (set to the number of CPU cores) and DB connections per process.
# Keep WEB_CONCURRENCY x DB_POOL_SIZE below PostgreSQL max_connections.
WEB_CONCURRENCY=1
DB_POOL_SIZE=10

# true if students open the site via https:// (recommended). false for plain http, e.g. http://192.168.1.10:4000
HTTPS=false
# Number of reverse proxies in front of the app (1 behind nginx / a load balancer).
TRUST_PROXY=
# Only needed if the frontend is hosted on a different origin, comma separated.
CORS_ORIGIN=

# Seconds after a student's deadline in which in-flight answer saves are still accepted.
SUBMIT_GRACE_SECONDS=15
AUTO_SUBMIT_INTERVAL_MS=30000
# Login attempts per email+IP and registrations per IP, per 15 minutes (per server process).
LOGIN_RATE_LIMIT=20
REGISTER_RATE_LIMIT=500
