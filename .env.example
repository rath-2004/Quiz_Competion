# Copy to .env and adjust. Never commit the real .env file.

# --- Database ---------------------------------------------------------------
# Local development (npm run dev):
DATABASE_URL=postgres://postgres:postgres@localhost:5432/quiz
# Used by docker-compose.yml for the bundled PostgreSQL container:
POSTGRES_PASSWORD=change-me
# Connections per app process. Keep WEB_CONCURRENCY x DB_POOL_MAX below PostgreSQL's max_connections.
DB_POOL_MAX=20

# --- Security ---------------------------------------------------------------
# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Required when NODE_ENV=production. Changing it logs everyone out.
JWT_SECRET=

# Cookies are HTTPS-only in production. Set to false ONLY if you serve the site over
# plain http (e.g. on a campus LAN) — otherwise logins will not stick.
# COOKIE_SECURE=true

# Set to 1 when running behind one reverse proxy (nginx, Caddy, a load balancer) so
# rate limits see each student's real IP instead of the proxy's.
# TRUST_PROXY=1

# --- First admin account (created on first start if no admin exists) --------
ADMIN_NAME=Quiz Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# --- Server -----------------------------------------------------------------
PORT=4000
# Number of worker processes. Use the number of CPU cores on the server.
WEB_CONCURRENCY=1

# --- Tuning (defaults are fine) -------------------------------------------------
# Seconds after a deadline during which in-flight answers are still accepted.
# SUBMIT_GRACE_SECONDS=15
# How often expired attempts are auto-submitted.
# SWEEP_INTERVAL_SECONDS=20
# Registrations allowed per IP per 10 minutes (a whole campus may share one IP).
# REGISTER_LIMIT_PER_IP=1000
# Failed logins allowed per account + IP per 15 minutes.
# LOGIN_LIMIT_PER_ACCOUNT=20
